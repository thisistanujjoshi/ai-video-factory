APP_ENV=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_video_factory
REDIS_URL=redis://localhost:6379/0

# Empty/unset = mock (default). Set to "gemini" for the real Google Gemini
# provider (needs a key from https://aistudio.google.com/api-keys) -- see
# BUILD_STATUS.md Phase 5 for what's verified live vs. implemented-only.
LLM_PROVIDER=
LLM_API_KEY=

IMAGE_PROVIDER=
IMAGE_API_KEY=

VIDEO_PROVIDER=
VIDEO_API_KEY=

# "gemini" here reuses the same Google AI Studio key as LLM_API_KEY above
# -- live-verified real narration (see BUILD_STATUS.md).
TTS_PROVIDER=
TTS_API_KEY=

# Not in the spec's original list -- added for content-memory similarity
# detection (section 37). "gemini" implemented, not live-tested (see
# BUILD_STATUS.md Phase 8).
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

STORAGE_PROVIDER=local

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
